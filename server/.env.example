PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cpace_db

# ── Email (password reset code) ─────────────────────────────────────────────
# Set these to actually send reset codes by email. If left blank, the code is
# logged to the server console and returned as `dev_code` for local testing.
# Gmail example: create an App Password (Google account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=CPAce <your-email@gmail.com>

# ── Study materials ─────────────────────────────────────────────────────────
# Where the Laravel app's public/ folder is served from (XAMPP). Uploaded
# material files are opened at <WEB_BASE_URL>/storage/<file_path>.
# Leave blank to assume the same host the mobile app reaches this API on.
# WEB_BASE_URL=http://192.168.1.10/CPACE/CPACE/public
